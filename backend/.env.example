# AlphaDesk Environment Configuration
# Copy this file to .env and fill in your values

# ── NVIDIA NIM API ────────────────────────────────────────
# Get your free API key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── NVIDIA NIM Model IDs (all served via NVIDIA NIM API) ──
# Extractor agent: fast, low-temperature JSON extraction
EXTRACTOR_MODEL=microsoft/phi-4-mini-instruct

# Contradiction judge, bull/bear reviewers, meta-auditor
JUDGE_MODEL=qwen/qwen3-4b
REVIEWER_MODEL=qwen/qwen3-4b
AUDITOR_MODEL=qwen/qwen3-4b

# Research note writer: good at long-form structured writing
WRITER_MODEL=google/gemma-3-4b-it

# ── SERVER ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── DATABASE ──────────────────────────────────────────────
# SQLite path (ephemeral on Render free tier — use Turso/Supabase for production)
DB_PATH=./data/alphadesk.db

# ── UPSTASH REDIS (production persistence for watchlist/prices) ──
# Get free Redis at: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
